# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (SSR)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current key name from Supabase docs:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Backward-compatible fallback if you still use the legacy anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Database (use the Supabase Session pooler connection string by default)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: comma-separated emails that should receive the admin role on first profile creation
ADMIN_EMAILS=you@example.com
